function inisialisasiFirebase(){
  try{
    if(typeof firebase === "undefined") return false;
    const app = firebase.initializeApp(FIREBASE_CONFIG);
    db = firebase.database(app);
    return true;
  }catch(e){ console.warn("[QUANTA] Firebase:",e.message); return false; }
}
async function simpanKeFirebase(payload){
  if(!db){ tampilkanStatusFirebase("⚠️ Firebase belum terhubung. Skor tidak tersimpan ke leaderboard.",false); return; }
  try{
    await db.ref(`tantangan/leaderboard/${state.level}`).push(payload);
    tampilkanStatusFirebase("✅ Skor berhasil tersimpan ke leaderboard!",true);
  }catch(e){ tampilkanStatusFirebase("❌ Gagal menyimpan skor: "+e.message,false); }
}
function tampilkanStatusFirebase(pesan,sukses){
  const el=pilih("pesanFirebase"); el.textContent=pesan; el.className="firebase-status "+(sukses?"ok":"error"); el.classList.remove("hidden");
}
