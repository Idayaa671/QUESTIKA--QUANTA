function mulaiPermainan(level){
  const cfg=LEVEL_CONFIG[level];
  const pg=acak([...BANK_SOAL[level].filter(s=>s.tipe==="mcq")]);
  const es=acak([...BANK_SOAL[level].filter(s=>s.tipe==="esai")]);
  state.level=level; state.poin=0; state.benar=0; state.nomorSoal=0; state.waktuSisa=cfg.waktu; state.totalWaktu=cfg.waktu; state.deadline=Date.now()+cfg.waktu*1000; state.bonusWaktu=0; state.selesai=false;
  state.soal=[...pg.slice(0,cfg.jumlahPG),...es.slice(0,cfg.jumlahEsai)];
  acak(state.soal); state.jawaban=new Array(state.soal.length).fill(null); state.hasilSoal=[];
  pilih("arenaNama").textContent=state.nama; pilih("arenaLevel").textContent=cfg.label;
  tampilkanLayar("layarArena"); renderNavigasiSoal(); tampilkanSoal(); mulaiTimer();
}
function tampilkanSoal(){
  if(state.selesai) return;
  const soal=state.soal[state.nomorSoal];
  pilih("soalNomor").textContent=`SOAL ${state.nomorSoal+1} · ${soal.tipe==="mcq"?"PILIHAN GANDA":"ESAI"}`;
  pilih("soalTeks").textContent=soal.teks;
  const f=pilih("soalFungsi"); f.textContent=soal.fungsi||""; f.classList.toggle("hidden",!soal.fungsi);
  const total=state.soal.length, answered=state.jawaban.filter(v=>v!==null && v!=="").length;
  pilih("arenaProgressBar").style.width=((state.nomorSoal+1)/total*100)+"%";
  pilih("arenaProgresLabel").textContent=`Soal ${state.nomorSoal+1} / ${total}`;
  pilih("arenaTerjawabLabel").textContent=`Terjawab ${answered}/${total}`;
  pilih("arenaPoin").textContent=state.poin;
  sembunyikan("btnSoalBerikut");
  const kotakMCQ=pilih("kotakMCQ");
  const kotakIsian=pilih("kotakIsian");
  if(soal.tipe==="mcq"){
    sembunyikan("kotakIsian");
    tampilkan("kotakMCQ");
    kotakMCQ.innerHTML="";
    soal.pilihan.forEach((teksPilihan,i)=>{
      const btn=document.createElement("button");
      btn.type="button";
      btn.className="btn-pilihan";
      btn.dataset.idx=i;
      btn.innerHTML=`<span class="option-letter">${String.fromCharCode(65+i)}.</span><span class="option-text"></span>`;
