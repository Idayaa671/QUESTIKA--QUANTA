function normalisasiHeaderExcel(v){return String(v??"").toLowerCase().replace(/[ _-]/g,"").trim();}
function angkaExcel(v,def=0){
  if(v===null||v===undefined||v==="")return def;
  const n=Number(String(v).replace(/,/g,".")); return Number.isFinite(n)?n:def;
}
async function prosesUploadExcel(file){
  if(!cekAksesGuru()||!db||!file)return;
  if(typeof XLSX==="undefined"){tampilkanStatusGuru("❌ Library Excel belum termuat. Periksa koneksi internet lalu refresh halaman.",false);return;}
  try{
    const buffer=await file.arrayBuffer();
    const wb=XLSX.read(buffer,{type:"array"});
    const ws=wb.Sheets[wb.SheetNames[0]];
    const rows=XLSX.utils.sheet_to_json(ws,{defval:""});
    if(!rows.length)throw new Error("File Excel tidak memiliki data.");
    const level=state.lbLevel||"mudah";
    const cfg=LEVEL_CONFIG[level];
    const entries={};
    rows.forEach((row,i)=>{
      const map={}; Object.keys(row).forEach(k=>map[normalisasiHeaderExcel(k)]=row[k]);
      const nama=String(map.nama||map.namasiswa||map.siswa||"").trim();
      if(!nama)return;
      const poin=angkaExcel(map.poin,0);
      const total=angkaExcel(map.total,cfg.jumlah);
      const benar=angkaExcel(map.benar,0);
      const durasi=angkaExcel(map.durasi,0);
      const nilai=angkaExcel(map.nilai,0);
      const bonusWaktu=angkaExcel(map.bonuswaktu,0);
      const key=db.ref(`tantangan/leaderboard/${level}`).push().key;
      entries[key]={nama,poin,benar,total,durasi,nilai,bonusWaktu,timestamp:Date.now(),sumber:"excel"};
    });
    const count=Object.keys(entries).length;
    if(!count)throw new Error("Tidak ada baris valid. Pastikan ada kolom Nama.");
    await db.ref(`tantangan/leaderboard/${level}`).update(entries);
    tampilkanStatusGuru(`✅ ${count} data berhasil di-upload ke leaderboard level ${cfg.label}.`);
    muatLeaderboard(level);
  }catch(e){tampilkanStatusGuru(`❌ Upload Excel gagal: ${e.message}`,false);}
  finally{pilih("inputExcel").value="";}
}

