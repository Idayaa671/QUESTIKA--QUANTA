      btn.onclick=()=>pilihMCQ(i);
      kotakMCQ.appendChild(btn);
    });
  }else{
    sembunyikan("kotakMCQ");
    tampilkan("kotakIsian");
    const input=pilih("inputJawaban");
    input.value=state.jawaban[state.nomorSoal]||"";
    input.disabled=false;
    input.oninput=()=>{state.jawaban[state.nomorSoal]=input.value;renderNavigasiSoal();};
  }
  renderNavigasiSoal();
}
function pilihMCQ(idx){ state.jawaban[state.nomorSoal]=idx; document.querySelectorAll(".btn-pilihan").forEach((b,i)=>b.classList.toggle("selected",i===idx)); renderNavigasiSoal(); }
function renderNavigasiSoal(){
  const nav=pilih("navSoal"); if(!nav) return; nav.innerHTML="";
  state.soal.forEach((s,i)=>{const b=document.createElement("button");b.type="button";b.textContent=i+1;b.title=`Soal ${i+1} · ${s.tipe==="mcq"?"Pilihan ganda":"Esai"}`;if(s.tipe==="esai")b.classList.add("esai");if(state.jawaban[i]!==null&&state.jawaban[i]!=="")b.classList.add("terjawab");if(i===state.nomorSoal)b.classList.add("aktif");b.onclick=()=>{state.nomorSoal=i;tampilkanSoal();};nav.appendChild(b);});
}
function mulaiTimer(){
  clearInterval(state.timerInterval);
  state.deadline=Date.now()+state.waktuSisa*1000;
  renderTimer();
  state.timerInterval=setInterval(()=>{
    const sisa=Math.max(0,state.deadline-Date.now());
    state.waktuSisa=Math.ceil(sisa/1000);
    renderTimer();
    if(sisa<=0){
      clearInterval(state.timerInterval);
      state.waktuSisa=0;
      renderTimer();
      selesaiPermainan(true);
    }
  },250);
}
function renderTimer(){
  const el=pilih("arenaTimer");
  if(!el)return;
  el.textContent=formatWaktu(Math.max(0,state.waktuSisa));
  const p=state.totalWaktu?state.waktuSisa/state.totalWaktu:0;
  el.className="arena-timer "+(p<=.15?"danger":p<=.35?"warn":"");
}
function kumpulkanDenganKonfirmasi(){
  const belum=state.jawaban.filter(v=>v===null||v==="").length;
  if(belum>0 && !confirm(`Masih ada ${belum} soal yang belum dijawab. Soal tersebut akan dinilai sebagai tidak dijawab. Tetap kumpulkan?`)) return;
  selesaiPermainan(false);
}
function selesaiPermainan(waktuHabis=false){
  if(state.selesai) return; state.selesai=true; clearInterval(state.timerInterval);
  const cfg=LEVEL_CONFIG[state.level]; state.hasilSoal=[]; state.poin=0; state.benar=0;
  state.soal.forEach((s,i)=>{
    const raw=state.jawaban[i]; const kosong=raw===null||raw===""; let status=false, skor=0, jawabanSiswa="Tidak dijawab";
    if(s.tipe==="mcq"){
      if(!kosong){jawabanSiswa=s.pilihan[raw]??"Tidak dijawab";status=raw===s.jawaban;skor=status?cfg.poinMCQ:0;}
      state.hasilSoal.push({soal:s,jawabanSiswa,jawabanBenar:s.pilihan[s.jawaban],status,skor});
    }else{
      if(!kosong){jawabanSiswa=String(raw);const match=hitungKecocokanEsai(jawabanSiswa,s.keywords);skor=Math.round(cfg.poinEsai*match);status=match>=.8;}
      state.hasilSoal.push({soal:s,jawabanSiswa,jawabanBenar:s.jawabanTeks,status,skor,match:!kosong?hitungKecocokanEsai(jawabanSiswa,s.keywords):0});
    }
    state.poin+=skor;if(status)state.benar++;
  });
  state.bonusWaktu=waktuHabis?0:Math.round((state.waktuSisa/state.totalWaktu)*cfg.bonusMaks); state.poin+=state.bonusWaktu;
  const total=state.soal.length, nilai=Math.round((state.hasilSoal.reduce((a,b)=>a+b.skor,0)/maksPoin(cfg))*100);
  renderHasil(nilai,total,waktuHabis); tampilkanLayar("layarHasil");
  simpanKeFirebase({nama:state.nama,poin:state.poin,benar:state.benar,total,waktuSisa:state.waktuSisa,durasi:state.totalWaktu-state.waktuSisa,nilai,timestamp:Date.now()});
}
function renderHasil(nilai,total,waktuHabis){
  let badge="💪",judul="Tetap Berlatih!",sub="Buka pembahasan di bawah untuk melihat bagian yang perlu diperkuat.";
  if(nilai>=90){badge="🏆";judul="Master Challenge!";sub="Performa sangat kuat. Pertahankan ketelitianmu."}
  else if(nilai>=75){badge="🔥";judul="Challenge Ditaklukkan!";sub="Hasilmu sudah bagus. Cek pembahasan untuk menyempurnakannya."}
  else if(nilai>=60){badge="⚡";judul="Makin Dekat!";sub="Dasarmu sudah terbentuk. Pelajari soal yang masih keliru."}
  if(waktuHabis)sub="Waktu habis. Tidak apa-apa—gunakan pembahasan untuk memperbaiki strategi pengerjaan berikutnya.";
  pilih("hasilBadge").textContent=badge;pilih("hasilJudul").textContent=judul;pilih("hasilSub").textContent=sub;pilih("hasilPoin").textContent=state.poin;pilih("hasilBenar").textContent=`${state.benar}/${total}`;pilih("hasilNilai").textContent=nilai;pilih("hasilBonus").textContent=`+${state.bonusWaktu}`;sembunyikan("pesanFirebase");
  const list=pilih("reviewList");list.innerHTML="";
  state.hasilSoal.forEach((r,i)=>{
    const div=document.createElement("div");div.className=`review-item ${r.status?"good":"bad"}`;
    const skorText=r.soal.tipe==="esai"?`+${r.skor} poin · ${Math.round((r.match||0)*100)}% kecocokan`: `+${r.skor} poin`;
    div.innerHTML=`<div class="review-top"><span>Soal ${i+1} · ${r.soal.tipe==="mcq"?"PG":"ESAI"}</span><span class="${r.status?"status-good":"status-bad"}">${r.status?"✓ Benar":"✕ Perlu diperbaiki"} · ${skorText}</span></div><div class="review-question">${escHTML(r.soal.teks)}</div><div class="review-answer"><b>Jawabanmu:</b> ${escHTML(r.jawabanSiswa)}<br><b>Jawaban benar/model:</b> ${escHTML(r.jawabanBenar)}</div><div class="review-exp"><b>💡 Pembahasan:</b> ${escHTML(r.soal.penjelasan)}</div>`;
    list.appendChild(div);
  });
}
function hitungKecocokanEsai(jawaban,keywords){
  const t=normalisasi(jawaban); if(!t)return 0;
  let hit=0; keywords.forEach(k=>{if(t.includes(normalisasi(k)))hit++;});
  return keywords.length?Math.min(1,hit/Math.max(2,Math.ceil(keywords.length*.6))):0;
}
function normalisasi(s){return String(s).toLowerCase().replace(/−/g,"-").replace(/\s+/g," ").trim();}
function maksPoin(cfg){return cfg.jumlahPG*cfg.poinMCQ+cfg.jumlahEsai*cfg.poinEsai;}

/* ============================================================ UTILITAS */
function pilih(id){return document.getElementById(id)}
function tampilkan(id){pilih(id).classList.remove("hidden")}
function sembunyikan(id){pilih(id).classList.add("hidden")}
function formatWaktu(detik){const m=Math.floor(detik/60).toString().padStart(2,"0"),s=(detik%60).toString().padStart(2,"0");return `${m}:${s}`}
function acak(arr){for(let i=arr.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[arr[i],arr[j]]=[arr[j],arr[i]]}return arr}
function escHTML(str){return String(str??"").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;")}

